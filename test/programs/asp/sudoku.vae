; A 9x9 sudoku with 26 givens and one solution. A choice of value per cell, then four
; families of bounds: one value per cell, and each value at most once per row, per column
; and per box. A background rule numbers each cell's box and its place in the box, a
; solve-only rule projects a cell's value onto its box, and a hard constraint holds each
; given. Twin: sudoku.lp.
#base core
#context CxSudoku
(board_index 1)
(board_index 2)
(board_index 3)
(board_index 4)
(board_index 5)
(board_index 6)
(board_index 7)
(board_index 8)
(board_index 9)
(sudokuGiven 1 2 6)
(sudokuGiven 1 4 1)
(sudokuGiven 1 5 8)
(sudokuGiven 2 1 2)
(sudokuGiven 2 5 4)
(sudokuGiven 3 1 8)
(sudokuGiven 3 3 1)
(sudokuGiven 3 4 5)
(sudokuGiven 3 6 7)
(sudokuGiven 3 7 6)
(sudokuGiven 4 4 7)
(sudokuGiven 4 6 8)
(sudokuGiven 4 9 6)
(sudokuGiven 5 1 3)
(sudokuGiven 5 2 2)
(sudokuGiven 5 5 1)
(sudokuGiven 5 9 7)
(sudokuGiven 6 5 3)
(sudokuGiven 7 1 7)
(sudokuGiven 7 4 2)
(sudokuGiven 7 6 5)
(sudokuGiven 7 7 3)
(sudokuGiven 7 8 9)
(sudokuGiven 8 7 1)
(sudokuGiven 8 9 8)
(sudokuGiven 9 1 9)
(set/assumptionRule (implies (and (board_index ?r) (board_index ?c) (board_index ?v)) (cellValue ?r ?c ?v)))
(asp/atLeast 1 ?v (cellValue ?r ?c ?v))
(asp/atMost 1 ?v (cellValue ?r ?c ?v))
(asp/atMost 1 ?c (cellValue ?r ?c ?v))
(asp/atMost 1 ?r (cellValue ?r ?c ?v))
(implies (and (board_index ?r) (board_index ?c)
              (evaluate ?b (+ (- ?r 1 (mod (- ?r 1) 3)) (/ (- ?c 1 (mod (- ?c 1) 3)) 3) 1))
              (evaluate ?k (+ (* 3 (mod (- ?r 1) 3)) (mod (- ?c 1) 3) 1)))
         (cellBox ?r ?c ?b ?k))
(set/inertRule (set/solveRule (implies (and (cellValue ?r ?c ?v) (cellBox ?r ?c ?b ?k)) (boxHolds ?b ?v ?k))))
(asp/atMost 1 ?k (boxHolds ?b ?v ?k))
(set/hardConstraint (implies (and (sudokuGiven ?r ?c ?v) (not (cellValue ?r ?c ?v))) (givenBroken ?r ?c ?v)))
#models (cellValue ?r ?c ?v)
