; Directed Hamiltonian cycles of the cube graph Q3. A choice per directed edge, at most
; one chosen edge out of and into each vertex, and reachability from Q0 over the chosen
; edges as two solve-only rules, one of them recursive. A hard constraint requires every
; vertex reached. The rules compute reachability from Q0 alone, which is the magic-sets
; specialisation of a general reach relation to the one source the constraint reads.
; Q3 has 6 undirected Hamiltonian cycles, 12 directed. Twin: hamilton.lp.
#base core
#context CxTour
(graph_node Q0)
(graph_node Q1)
(graph_node Q2)
(graph_node Q3)
(graph_node Q4)
(graph_node Q5)
(graph_node Q6)
(graph_node Q7)
(graphEdge Q0 Q1)
(graphEdge Q1 Q0)
(graphEdge Q0 Q2)
(graphEdge Q2 Q0)
(graphEdge Q0 Q4)
(graphEdge Q4 Q0)
(graphEdge Q1 Q3)
(graphEdge Q3 Q1)
(graphEdge Q1 Q5)
(graphEdge Q5 Q1)
(graphEdge Q2 Q3)
(graphEdge Q3 Q2)
(graphEdge Q2 Q6)
(graphEdge Q6 Q2)
(graphEdge Q3 Q7)
(graphEdge Q7 Q3)
(graphEdge Q4 Q5)
(graphEdge Q5 Q4)
(graphEdge Q4 Q6)
(graphEdge Q6 Q4)
(graphEdge Q5 Q7)
(graphEdge Q7 Q5)
(graphEdge Q6 Q7)
(graphEdge Q7 Q6)
(set/assumptionRule (implies (graphEdge ?x ?y) (tourEdge ?x ?y)))
(asp/atMost 1 ?y (tourEdge ?x ?y))
(asp/atMost 1 ?x (tourEdge ?x ?y))
(set/inertRule (set/solveRule (implies (tourEdge Q0 ?y) (tourReaches Q0 ?y))))
(set/inertRule (set/solveRule (implies (and (tourReaches Q0 ?x) (tourEdge ?x ?y)) (tourReaches Q0 ?y))))
(set/hardConstraint (implies (and (graph_node ?y) (not (tourReaches Q0 ?y))) (unreached ?y)))
#models (tourEdge ?x ?y)
#cautious (tourReaches Q0 ?y)
#brave (tourEdge Q0 ?y)
